# Bokun booking URL fallback (used if no tour-specific URL is provided)
NEXT_PUBLIC_BOKUN_BOOKING_URL=https://book.realparis.tours

# Optional per-tour Bokun URLs
NEXT_PUBLIC_BOKUN_BIKE_HIGHLIGHTS_URL=
NEXT_PUBLIC_BOKUN_REAL_PARIS_URL=

# Bokun tour sync (build-time)
# Set this to your Bokun API/listing endpoint returning experience data as JSON.
BOKUN_TOURS_API_URL=

# Optional auth headers for Bokun fetch.
# Use Bearer token via BOKUN_API_TOKEN and/or API key via BOKUN_API_KEY.
BOKUN_API_TOKEN=
BOKUN_API_KEY=

# Optional JSON headers object for custom Bokun auth/header needs.
# Example: {"x-bokun-access-key":"...","x-bokun-secret-key":"..."}
BOKUN_REQUEST_HEADERS_JSON=

# If true, build fails when Bokun sync is not configured or fails.
BOKUN_SYNC_REQUIRED=false

